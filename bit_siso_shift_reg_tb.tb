module tb_siso_shift_register;
    reg clk, reset, serial_in;
    wire serial_out;

    // Instantiate DUT
    siso_shift_register uut (
        .clk(clk),
        .reset(reset),
        .serial_in(serial_in),
        .serial_out(serial_out)
    );

    // Clock generation
    always #5 clk = ~clk; // 10 time units period

    initial begin
        // Initialize
        clk = 0; reset = 1; serial_in = 0;
        #10 reset = 0;

        // Apply serial input sequence
        serial_in = 1; #10;
        serial_in = 0; #10;
        serial_in = 1; #10;
        serial_in = 1; #10;
        serial_in = 0; #10;
        serial_in = 0; #10;
        serial_in = 1; #10;
        serial_in = 1; #10;

        // Finish simulation
        #50 $finish;
    end
endmodule
